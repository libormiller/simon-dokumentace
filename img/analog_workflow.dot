digraph ASIC_Analog_Flow {
    // Základní nastavení grafu
    rankdir=TB;             // Průřezově striktní vertikální tok
    splines=true;           // Plynulé zakřivení
    compound=true;
    nodesep=0.8;            // Dostatečný odstup pro boční vedení
    ranksep=0.45;           // Vertikální mezerování mezi bloky
    
    // Globální nastavení LaTeXového písma
    fontname="Latin Modern Roman, CMU Serif, Times-Roman, serif";

    // Globální styl uzlů
    node [
        fontname="Latin Modern Roman, CMU Serif, Times-Roman, serif",
        fontsize=10,
        shape=box,
        style="rounded,filled",
        fillcolor="#FFFFFF",
        color="#333333",
        penwidth=1.2,
        margin="0.25,0.12",
        group=main          // Udržuje uzly v hlavní svislé ose
    ];
    
    // Globální styl hran
    edge [
        fontname="Latin Modern Roman, CMU Serif, Times-Roman, serif",
        fontsize=9,
        color="#333333",
        penwidth=1.0,
        arrowsize=0.8
    ];

    // Počáteční a koncový stav
    start [label="Nový blok", shape=ellipse, fillcolor="#F0F4F8", color="#104E8B", penwidth=1.5];
    valid_block [label="Validní blok", shape=ellipse, fillcolor="#E8F5E9", color="#2E7D32", penwidth=1.5];

    // --- XSCHEM ---
    subgraph cluster_xschem {
        label="XSCHEM";
        fontname="Latin Modern Roman, CMU Serif, Times-Roman, serif";
        fontsize=10;
        style="dashed";
        color="#666666";
        penwidth=1.2;
        labeljust="l";
        margin=14;
        
        schematic [label="Schematický návrh"];
        extract_spice [label="Extrakce SPICE netlistu"];
        
        schematic -> extract_spice;
    }

    // --- NGSPICE (Před-layoutová simulace) ---
    subgraph cluster_ngspice1 {
        label="NGSPICE";
        fontname="Latin Modern Roman, CMU Serif, Times-Roman, serif";
        fontsize=10;
        style="dashed";
        color="#666666";
        penwidth=1.2;
        labeljust="l";
        margin=14;
        
        tb_schematic [label="SPICE testbench\n(schematická simulace)"];
    }

    // --- MAGIC ---
    subgraph cluster_magic {
        label="MAGIC";
        fontname="Latin Modern Roman, CMU Serif, Times-Roman, serif";
        fontsize=10;
        style="dashed";
        color="#666666";
        penwidth=1.2;
        labeljust="l";
        margin=14;
        
        import_layout [label="Import SPICE netlistu do layoutu"];
        layout [label="Layout"];
        extract_rcx [label="Extrakce RCX SPICE netlistu"];
        
        import_layout -> layout -> extract_rcx;
    }

    // --- NGSPICE (Po-layoutová simulace) ---
    subgraph cluster_ngspice2 {
        label="NGSPICE";
        fontname="Latin Modern Roman, CMU Serif, Times-Roman, serif";
        fontsize=10;
        style="dashed";
        color="#666666";
        penwidth=1.2;
        labeljust="l";
        margin=14;
        
        tb_postlayout [label="SPICE testbench\n(post-layout RCX simulace)"];
    }

    // --- NETGEN ---
    subgraph cluster_netgen {
        label="NETGEN";
        fontname="Latin Modern Roman, CMU Serif, Times-Roman, serif";
        fontsize=10;
        style="dashed";
        color="#666666";
        penwidth=1.2;
        labeljust="l";
        margin=14;
        
        compare_netlists [label="Porovnání SPICE netlistů"];
    }

    // --- HLAVNÍ DOPŘEDNÝ TOK ---
    start -> schematic;
    extract_spice -> tb_schematic;
    tb_schematic -> import_layout;
    extract_rcx -> tb_postlayout;
    tb_postlayout -> compare_netlists;
    compare_netlists -> valid_block;

    // --- ZPĚTNÉ VAZBY / ITERACE ---
    schematic -> tb_schematic [dir=back, constraint=false];
    layout -> tb_postlayout [dir=back, constraint=false];
    schematic -> tb_postlayout [dir=back, constraint=false];
    layout -> compare_netlists [dir=back, constraint=false];
}